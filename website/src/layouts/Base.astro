---
interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const {
  title = 'fiddlehead — meeting notes for ai agents',
  description = 'transcribe meetings with openai or assemblyai, structure with gpt-4o-mini. local markdown files your ai agents can actually use.',
  ogImage = '/images/og-image.png',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Google Analytics -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-5LQSQTJZBL"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-5LQSQTJZBL');
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- preload fonts -->
    <link rel="preload" href="/fonts/GeistMono-Light.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/GeistMono-Regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/GeistMono-Medium.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/GeistMono-Bold.woff2" as="font" type="font/woff2" crossorigin />

    <!-- favicon -->
    <link rel="icon" type="image/svg+xml" href="/images/frog-icon-bg.svg" />
    <link rel="apple-touch-icon" href="/images/frog-icon-bg.svg" />

    <!-- og -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- structured data -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "SoftwareApplication",
      "name": "Fiddlehead",
      "operatingSystem": "macOS 14+",
      "applicationCategory": "ProductivityApplication",
      "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
      "description": description,
    })} />
  </head>
  <body>
    <slot />

    <script src="../scripts/scroll-observer.js"></script>
    <script src="../scripts/nav-scroll.js"></script>
    <script is:inline>
      document.addEventListener('click', function(e) {
        var link = e.target.closest('a[href="/download"]');
        if (link) {
          gtag('event', 'file_download', {
            file_name: 'Fiddlehead-latest.dmg',
            link_url: '/download'
          });
        }
      });
    </script>
  </body>
</html>

<style is:global>
  @import '../styles/global.css';
  @import '../styles/animations.css';
</style>
