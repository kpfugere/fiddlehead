<section id="download" class="section-full">
  <div class="download-content reveal">
    <h2 class="heading-lg">ready when you are.</h2>
    <p class="subhead download-sub">
      download fiddlehead, add your api keys, and start transcribing.
      your first structured meeting note in under two minutes.
    </p>
    <div class="download-actions">
      <a href="#" class="btn-primary download-btn">
        download for macos
      </a>
    </div>
    <p class="download-meta">macos 14+ · apple silicon & intel · free</p>
    <a href="#" class="download-tip" target="_blank" rel="noopener noreferrer">
      buy me a coffee ☕
    </a>
  </div>
</section>

<style>
  .download-content {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0;
  }

  .download-sub {
    margin: var(--space-lg) auto var(--space-xl);
  }

  .download-actions {
    margin-bottom: var(--space-md);
  }

  .download-btn {
    font-size: 15px;
    padding: 14px 32px;
  }

  .download-meta {
    font-size: 14px;
    color: var(--text-secondary);
    opacity: 0.6;
    margin-bottom: var(--space-xl);
  }

  .download-tip {
    font-size: 14px;
    color: var(--text-secondary);
    opacity: 0.5;
    transition: opacity 0.2s, color 0.2s;
  }
  .download-tip:hover {
    opacity: 1;
    color: var(--accent);
  }
</style>
