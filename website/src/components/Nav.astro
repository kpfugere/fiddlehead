---
const links = [
  { href: '#demo', label: 'demo' },
  { href: '#how-it-works', label: 'how it works' },
  { href: '#setup', label: 'setup' },
  { href: '#output', label: 'output' },
  { href: '#agent-native', label: 'agents' },
  { href: '#skills', label: 'skills' },
  { href: '/compare', label: 'compare' },
  { href: '/pricing', label: 'pricing' },
  { href: '#download', label: 'download' },
];
---

<nav id="main-nav" class="nav nav-hidden" aria-label="Main navigation">
  <div class="nav-inner">
    <a href="#hero" class="nav-logo" aria-label="Back to top">
      <img src="/images/frog-icon.svg" alt="" width="28" height="21" />
    </a>
    <div class="nav-links">
      {links.map(link => (
        <a href={link.href} class="nav-link" data-section={link.href.slice(1)}>
          {link.label}
        </a>
      ))}
    </div>
  </div>
</nav>

<style>
  .nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    background: rgba(24, 20, 15, 0.92);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border);
    transition: transform 0.3s ease, opacity 0.3s ease;
  }

  .nav-inner {
    max-width: 1080px;
    margin: 0 auto;
    padding: 0 var(--space-xl);
    height: 52px;
    display: flex;
    align-items: center;
    gap: var(--space-xl);
  }

  .nav-logo {
    flex-shrink: 0;
    display: flex;
    align-items: center;
  }
  .nav-logo img {
    display: block;
    color: var(--text-primary);
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: var(--space-lg);
    overflow-x: auto;
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
  .nav-links::-webkit-scrollbar { display: none; }

  .nav-link {
    font-size: 13px;
    font-weight: 400;
    color: var(--text-secondary);
    white-space: nowrap;
    padding: 4px 0;
    transition: color 0.2s;
  }
  .nav-link:hover,
  .nav-link.active {
    color: var(--text-primary);
  }
  .nav-link.active {
    color: var(--accent);
  }

  @media (max-width: 768px) {
    .nav-inner {
      padding: 0 var(--space-lg);
    }
    .nav-links {
      gap: var(--space-md);
    }
    .nav-link {
      font-size: 12px;
    }
  }
</style>
