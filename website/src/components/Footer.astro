---
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="footer-inner">
    <img src="/images/frog-icon.svg" alt="" width="24" height="18" class="footer-icon" />
    <p class="footer-text">&copy; {year} fiddlehead</p>
    <a
      href="https://github.com"
      class="footer-link"
      target="_blank"
      rel="noopener noreferrer"
    >
      github
    </a>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--border);
    padding: var(--space-xl);
  }

  .footer-inner {
    max-width: 1080px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-md);
  }

  .footer-icon {
    opacity: 0.4;
  }

  .footer-text {
    font-size: 13px;
    color: var(--text-secondary);
    opacity: 0.6;
  }

  .footer-link {
    font-size: 13px;
    color: var(--text-secondary);
    opacity: 0.6;
    transition: opacity 0.2s;
  }
  .footer-link:hover {
    opacity: 1;
    color: var(--accent);
  }
</style>
