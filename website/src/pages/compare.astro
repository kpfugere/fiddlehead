---
import Base from '../layouts/Base.astro';
import Footer from '../components/Footer.astro';

const features = [
  {
    label: 'Pricing',
    fiddlehead: '$29 one-time',
    granola: '$18/mo',
    otter: '$8–17/mo',
    fireflies: '$10–18/mo',
  },
  {
    label: 'Subscription required',
    fiddlehead: 'No',
    granola: 'Yes',
    otter: 'Yes',
    fireflies: 'Yes',
    fiddleheadWin: true,
  },
  {
    label: 'Meeting bot joins call',
    fiddlehead: 'No',
    granola: 'No',
    otter: 'Yes',
    fireflies: 'Yes',
    fiddleheadWin: true,
  },
  {
    label: 'Speaker diarization',
    fiddlehead: 'Named speakers',
    granola: 'No',
    otter: 'Business+ only',
    fireflies: 'Yes',
    fiddleheadWin: true,
  },
  {
    label: 'Output format',
    fiddlehead: 'Markdown + YAML',
    granola: 'Proprietary',
    otter: 'Proprietary',
    fireflies: 'Proprietary',
    fiddleheadWin: true,
  },
  {
    label: 'Data storage',
    fiddlehead: 'Local (your Mac)',
    granola: 'Cloud',
    otter: 'Cloud',
    fireflies: 'Cloud',
    fiddleheadWin: true,
  },
  {
    label: 'AI-agent ready',
    fiddlehead: 'Yes (YAML frontmatter)',
    granola: 'MCP only',
    otter: 'No',
    fireflies: 'No',
    fiddleheadWin: true,
  },
  {
    label: 'Platform',
    fiddlehead: 'macOS',
    granola: 'macOS, Windows, Web',
    otter: 'Web, iOS, Android',
    fireflies: 'Web, iOS, Android',
  },
  {
    label: 'File ownership',
    fiddlehead: 'Plain .md files',
    granola: 'Cloud-locked',
    otter: 'Cloud-locked',
    fireflies: 'Cloud-locked',
    fiddleheadWin: true,
  },
  {
    label: 'Free tier',
    fiddlehead: '10 recordings',
    granola: '25 meetings',
    otter: '300 min/mo',
    fireflies: '800 min storage',
  },
  {
    label: 'Language support',
    fiddlehead: 'English',
    granola: '10+',
    otter: '3 languages',
    fireflies: '100+',
  },
];

const differentiators = [
  {
    title: 'no subscription',
    desc: '$29 once vs $216+/year for competitors. you own the license forever, including all future updates.',
  },
  {
    title: 'your files, your machine',
    desc: 'plain markdown files saved locally. no export button because there\'s nothing to export — they\'re already files on your mac.',
  },
  {
    title: 'ai-agent native',
    desc: 'structured YAML frontmatter with date, speakers, topics, and tags. your AI agents can query meeting notes directly.',
  },
  {
    title: 'named speakers',
    desc: 'real names in every transcript — not "Me" and "Them." granola doesn\'t even do speaker diarization.',
  },
];
---

<Base
  title="compare — fiddlehead vs granola, otter.ai, fireflies"
  description="see how fiddlehead compares to granola, otter.ai, and fireflies. local-first meeting notes, no subscription, ai-agent ready."
>
  <nav class="page-nav">
    <div class="page-nav-inner">
      <a href="/" class="page-nav-logo" aria-label="Back to home">
        <img src="/images/frog-icon.svg" alt="" width="28" height="21" />
        <span class="page-nav-name">fiddlehead</span>
      </a>
    </div>
  </nav>

  <main>
    <section class="compare-hero">
      <div class="compare-hero-content hero-enter hero-enter-1">
        <h1 class="heading-lg">how fiddlehead compares</h1>
        <p class="subhead compare-sub">
          meeting notes tools compared — pricing, privacy, output format, and ai-agent readiness.
        </p>
      </div>
    </section>

    <section class="compare-table-section">
      <div class="table-scroll hero-enter hero-enter-2">
        <table class="compare-table">
          <thead>
            <tr>
              <th class="col-feature"></th>
              <th class="col-fiddlehead">fiddlehead</th>
              <th class="col-competitor">granola</th>
              <th class="col-competitor">otter.ai</th>
              <th class="col-competitor">fireflies</th>
            </tr>
          </thead>
          <tbody>
            {features.map(f => (
              <tr>
                <td class="col-feature">{f.label}</td>
                <td class:list={['col-fiddlehead', { 'cell-win': f.fiddleheadWin }]}>{f.fiddlehead}</td>
                <td class="col-competitor">{f.granola}</td>
                <td class="col-competitor">{f.otter}</td>
                <td class="col-competitor">{f.fireflies}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="compare-diff">
      <h2 class="heading-md reveal">why fiddlehead</h2>
      <div class="diff-grid reveal reveal-delay-1">
        {differentiators.map(d => (
          <div class="diff-card">
            <span class="glyph glyph-saved">✓</span>
            <div>
              <strong class="diff-title">{d.title}</strong>
              <p class="diff-desc">{d.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <section class="compare-cta reveal">
      <a href="/" class="btn-primary">download for macos</a>
      <p class="cta-note">free — 10 recordings included, no account required.</p>
    </section>
  </main>

  <Footer />
</Base>

<style>
  /* nav */
  .page-nav {
    border-bottom: 1px solid var(--border);
    padding: 0 var(--space-xl);
  }
  .page-nav-inner {
    max-width: 1080px;
    margin: 0 auto;
    height: 52px;
    display: flex;
    align-items: center;
  }
  .page-nav-logo {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    color: var(--text-primary);
  }
  .page-nav-logo:hover {
    color: var(--accent);
  }
  .page-nav-name {
    font-size: 14px;
    font-weight: 500;
  }

  /* hero */
  .compare-hero {
    padding: var(--space-3xl) var(--space-xl) var(--space-2xl);
    text-align: center;
    display: flex;
    justify-content: center;
  }
  .compare-hero-content {
    max-width: 640px;
  }
  .compare-sub {
    margin-top: var(--space-lg);
    margin-left: auto;
    margin-right: auto;
  }

  /* table */
  .compare-table-section {
    max-width: 1080px;
    margin: 0 auto;
    padding: 0 var(--space-xl) var(--space-3xl);
  }
  .table-scroll {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
  }
  .compare-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 14px;
    min-width: 820px;
  }
  .compare-table thead {
    border-bottom: 1px solid var(--border);
  }
  .compare-table th {
    padding: 12px 16px;
    font-size: 12px;
    font-weight: 500;
    text-align: left;
    letter-spacing: 0.04em;
  }
  .compare-table td {
    padding: 10px 16px;
    border-top: 1px solid var(--border);
    line-height: 1.5;
  }
  .col-feature {
    color: var(--text-primary);
    font-weight: 500;
    white-space: nowrap;
  }
  .col-fiddlehead {
    color: var(--accent);
    background: rgba(208, 165, 83, 0.04);
  }
  th.col-fiddlehead {
    color: var(--accent);
  }
  .col-competitor {
    color: var(--text-secondary);
    opacity: 0.7;
  }
  th.col-competitor {
    opacity: 0.5;
  }
  .cell-win {
    font-weight: 500;
  }

  /* differentiators */
  .compare-diff {
    max-width: 820px;
    margin: 0 auto;
    padding: 0 var(--space-xl) var(--space-3xl);
  }
  .compare-diff .heading-md {
    text-align: center;
    margin-bottom: var(--space-xl);
  }
  .diff-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-lg);
  }
  .diff-card {
    display: flex;
    gap: var(--space-md);
    padding: var(--space-xl);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface);
  }
  .diff-card .glyph {
    flex-shrink: 0;
    font-size: 14px;
    margin-top: 2px;
  }
  .diff-title {
    color: var(--text-primary);
    font-weight: 500;
    font-size: 15px;
    display: block;
    margin-bottom: 4px;
  }
  .diff-desc {
    color: var(--text-secondary);
    font-size: 13px;
    line-height: 1.65;
  }

  /* cta */
  .compare-cta {
    text-align: center;
    padding: 0 var(--space-xl) var(--space-3xl);
  }
  .cta-note {
    margin-top: var(--space-md);
    font-size: 13px;
    color: var(--text-secondary);
  }

  /* responsive */
  @media (max-width: 768px) {
    .diff-grid {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 640px) {
    .compare-hero {
      padding: var(--space-2xl) var(--space-lg) var(--space-xl);
    }
    .compare-table-section {
      padding: 0 var(--space-lg) var(--space-2xl);
    }
    .compare-diff {
      padding: 0 var(--space-lg) var(--space-2xl);
    }
    .compare-cta {
      padding: 0 var(--space-lg) var(--space-2xl);
    }
  }
</style>
