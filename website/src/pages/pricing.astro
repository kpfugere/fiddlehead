---
import Base from '../layouts/Base.astro';
import Footer from '../components/Footer.astro';

const githubUrl = 'https://github.com/kpfugere/Fiddlehead';

const features = [
  'mic + system audio capture',
  'speaker diarization',
  'ai-structured markdown notes',
  'auto mode (voice activity detection)',
  'calendar-aware recording',
  'local files — no cloud lock-in',
  'unlimited recordings',
  'bring your own openai / assemblyai key',
];

const faqs = [
  {
    q: 'is it really free?',
    a: 'yes. fiddlehead is open source under the mit license. the only cost is your own openai or assemblyai api usage, which you pay directly to them.',
  },
  {
    q: 'where is the source code?',
    a: 'github.com/kpfugere/fiddlehead. pull requests welcome.',
  },
  {
    q: 'can i use it on multiple macs?',
    a: 'yes — no license, no device limits. run it wherever you want.',
  },
  {
    q: 'why was this open-sourced?',
    a: 'shipping it for free to as many people as possible felt like more impact than chasing a small one-time-payment business.',
  },
];
---

<Base
  title="pricing — fiddlehead"
  description="fiddlehead is free and open source. mit licensed meeting note taker for macos."
>
  <nav class="pricing-nav">
    <div class="pricing-nav-inner">
      <a href="/" class="pricing-nav-logo" aria-label="Back to home">
        <img src="/images/frog-icon.svg" alt="" width="28" height="21" />
        <span class="pricing-nav-name">fiddlehead</span>
      </a>
    </div>
  </nav>

  <main>
    <section class="pricing-hero">
      <div class="pricing-hero-content hero-enter hero-enter-1">
        <h1 class="heading-lg">free and open source.</h1>
        <p class="subhead pricing-sub">
          no license, no paywall, no subscription. mit licensed — fork it, ship it, use it however you want.
        </p>
      </div>
    </section>

    <section class="pricing-flow">
      <div class="card flow-step flow-step-pro hero-enter hero-enter-2">
        <div class="flow-badge">mit license</div>
        <div class="flow-price">$0</div>
        <p class="flow-headline">unlimited recordings, forever.</p>
        <p class="flow-desc">bring your own openai or assemblyai api key. everything else is on the house.</p>
        <a href="/" class="btn-primary flow-cta">download</a>
        <a href={githubUrl} class="btn-secondary flow-cta flow-cta-secondary">view source on github</a>
      </div>
    </section>

    <section class="pricing-features reveal">
      <h2 class="features-heading">what you get</h2>
      <ul class="feature-list">
        {features.map(f => (
          <li class="feature-item">
            <span class="feature-check">✓</span>
            <span>{f}</span>
          </li>
        ))}
      </ul>
    </section>

    <section class="pricing-faq">
      <h2 class="heading-lg reveal">questions</h2>
      <div class="faq-grid reveal">
        {faqs.map(faq => (
          <div class="faq-item">
            <h3 class="faq-q">{faq.q}</h3>
            <p class="faq-a">{faq.a}</p>
          </div>
        ))}
      </div>
    </section>
  </main>

  <Footer />
</Base>

<style>
  /* nav */
  .pricing-nav {
    border-bottom: 1px solid var(--border);
    padding: 0 var(--space-xl);
  }
  .pricing-nav-inner {
    max-width: 1080px;
    margin: 0 auto;
    height: 52px;
    display: flex;
    align-items: center;
  }
  .pricing-nav-logo {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    color: var(--text-primary);
  }
  .pricing-nav-logo:hover {
    color: var(--accent);
  }
  .pricing-nav-name {
    font-size: 14px;
    font-weight: 500;
  }

  /* hero */
  .pricing-hero {
    padding: var(--space-3xl) var(--space-xl) var(--space-2xl);
    text-align: center;
    display: flex;
    justify-content: center;
  }
  .pricing-hero-content {
    max-width: 600px;
  }
  .pricing-sub {
    margin-top: var(--space-lg);
    margin-left: auto;
    margin-right: auto;
  }

  /* flow */
  .pricing-flow {
    max-width: 520px;
    margin: 0 auto;
    padding: 0 var(--space-xl) var(--space-3xl);
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .flow-step {
    width: 100%;
    text-align: center;
    padding: var(--space-xl);
  }

  .flow-step-pro {
    position: relative;
    border-color: var(--accent);
    box-shadow: 0 0 30px var(--glow-accent);
  }

  .flow-badge {
    position: absolute;
    top: calc(-1 * var(--space-sm) - 2px);
    right: var(--space-lg);
    background: var(--accent);
    color: var(--bg);
    font-size: 11px;
    font-weight: 500;
    padding: 2px 10px;
    border-radius: var(--radius);
  }

  .flow-price {
    font-size: 48px;
    font-weight: 700;
    color: var(--accent);
    line-height: 1.1;
    margin-bottom: var(--space-sm);
  }

  .flow-headline {
    font-size: 18px;
    font-weight: 500;
    color: var(--text-primary);
    margin-bottom: var(--space-sm);
  }

  .flow-desc {
    font-size: 13px;
    color: var(--text-secondary);
    margin-bottom: var(--space-xl);
    line-height: 1.6;
  }

  .flow-cta {
    width: 100%;
    text-align: center;
    justify-content: center;
  }

  .flow-cta-secondary {
    margin-top: var(--space-sm);
  }

  /* features */
  .pricing-features {
    max-width: 520px;
    margin: 0 auto;
    padding: 0 var(--space-xl) var(--space-3xl);
    text-align: center;
  }

  .features-heading {
    font-size: 14px;
    font-weight: 500;
    color: var(--text-secondary);
    margin-bottom: var(--space-xl);
  }

  .feature-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    text-align: left;
  }

  .feature-item {
    display: flex;
    align-items: baseline;
    gap: var(--space-sm);
    font-size: 14px;
    color: var(--text-secondary);
  }

  .feature-check {
    flex-shrink: 0;
    width: 20px;
    text-align: center;
    font-size: 13px;
    color: var(--saved);
  }

  /* faq */
  .pricing-faq {
    padding: var(--space-3xl) var(--space-xl);
    max-width: 820px;
    margin: 0 auto;
  }
  .pricing-faq .heading-lg {
    margin-bottom: var(--space-xl);
  }
  .faq-grid {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }
  .faq-item {
    border-bottom: 1px solid var(--border);
    padding-bottom: var(--space-lg);
  }
  .faq-item:last-child {
    border-bottom: none;
  }
  .faq-q {
    font-size: 15px;
    font-weight: 500;
    color: var(--text-primary);
    margin-bottom: var(--space-sm);
  }
  .faq-a {
    font-size: 14px;
    color: var(--text-secondary);
    line-height: 1.7;
  }

  /* responsive */
  @media (max-width: 640px) {
    .pricing-hero {
      padding: var(--space-2xl) var(--space-lg) var(--space-xl);
    }
    .pricing-flow {
      padding: 0 var(--space-lg) var(--space-2xl);
    }
    .pricing-features {
      padding: 0 var(--space-lg) var(--space-2xl);
    }
    .pricing-faq {
      padding: var(--space-2xl) var(--space-lg);
    }
    .flow-price {
      font-size: 40px;
    }
  }
</style>
