---
import Base from '../layouts/Base.astro';
import Footer from '../components/Footer.astro';

const checkoutUrl = 'https://store.fiddleheadai.com/checkout/buy/18ff7027-7060-4a0d-9fc3-099c2df5230c';

const features = [
  'mic + system audio capture',
  'speaker diarization',
  'ai-structured markdown notes',
  'auto mode (voice activity detection)',
  'calendar-aware recording',
  'local files — no cloud lock-in',
];

const faqs = [
  {
    q: 'is there a subscription?',
    a: 'no. it\'s a one-time payment. you own the license forever, including all future updates.',
  },
  {
    q: 'what happens after 10 recordings?',
    a: 'fiddlehead will prompt you to unlock with a license key. your existing notes are always accessible — you just can\'t create new recordings until you upgrade.',
  },
  {
    q: 'how do i activate my license?',
    a: 'after purchasing, you\'ll receive a license key via email. enter it in fiddlehead\'s settings or use the activation prompt. it takes about 5 seconds.',
  },
  {
    q: 'can i use it on multiple macs?',
    a: 'yes — each license supports up to 3 machines. perfect for a work laptop, personal mac, and a desktop.',
  },
  {
    q: 'what about refunds?',
    a: 'if fiddlehead doesn\'t work for you, reach out within 14 days for a full refund. no questions asked.',
  },
];
---

<Base
  title="pricing — fiddlehead"
  description="unlock unlimited meeting transcriptions with fiddlehead. $29 one-time payment, no subscription."
>
  <nav class="pricing-nav">
    <div class="pricing-nav-inner">
      <a href="/" class="pricing-nav-logo" aria-label="Back to home">
        <img src="/images/frog-icon.svg" alt="" width="28" height="21" />
        <span class="pricing-nav-name">fiddlehead</span>
      </a>
    </div>
  </nav>

  <main>
    <section class="pricing-hero">
      <div class="pricing-hero-content hero-enter hero-enter-1">
        <h1 class="heading-lg">pay once, use forever.</h1>
        <p class="subhead pricing-sub">
          start free. upgrade for $29 when you're ready — no subscription, ever.
        </p>
      </div>
    </section>

    <section class="pricing-flow">
      <!-- step 1: free -->
      <div class="flow-step flow-step-free hero-enter hero-enter-2">
        <div class="flow-label">start free</div>
        <p class="flow-headline">10 recordings included</p>
        <p class="flow-desc">download and try everything — no account, no credit card.</p>
        <a href="/" class="btn-secondary flow-cta">download</a>
      </div>

      <!-- connector -->
      <div class="flow-connector hero-enter hero-enter-3">
        <div class="flow-connector-line"></div>
        <span class="flow-connector-label">then</span>
        <div class="flow-connector-line"></div>
      </div>

      <!-- step 2: unlock -->
      <div class="card flow-step flow-step-pro hero-enter hero-enter-3">
        <div class="flow-badge">one-time payment</div>
        <div class="flow-price">$29</div>
        <p class="flow-headline">unlimited recordings, forever.</p>
        <p class="flow-desc">all future updates included. up to 3 macs per license.</p>
        <a href={checkoutUrl} class="btn-primary flow-cta">buy fiddlehead</a>
      </div>
    </section>

    <section class="pricing-features reveal">
      <h2 class="features-heading">everything included — free and pro</h2>
      <ul class="feature-list">
        {features.map(f => (
          <li class="feature-item">
            <span class="feature-check">✓</span>
            <span>{f}</span>
          </li>
        ))}
      </ul>
    </section>

    <section class="pricing-reassurance reveal">
      <span class="reassurance-item">14-day refund guarantee</span>
      <span class="reassurance-dot">·</span>
      <span class="reassurance-item">3 mac activations</span>
      <span class="reassurance-dot">·</span>
      <span class="reassurance-item">all future updates</span>
    </section>

    <section class="pricing-faq">
      <h2 class="heading-lg reveal">questions</h2>
      <div class="faq-grid reveal">
        {faqs.map(faq => (
          <div class="faq-item">
            <h3 class="faq-q">{faq.q}</h3>
            <p class="faq-a">{faq.a}</p>
          </div>
        ))}
      </div>
    </section>
  </main>

  <Footer />
</Base>

<style>
  /* nav */
  .pricing-nav {
    border-bottom: 1px solid var(--border);
    padding: 0 var(--space-xl);
  }
  .pricing-nav-inner {
    max-width: 1080px;
    margin: 0 auto;
    height: 52px;
    display: flex;
    align-items: center;
  }
  .pricing-nav-logo {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    color: var(--text-primary);
  }
  .pricing-nav-logo:hover {
    color: var(--accent);
  }
  .pricing-nav-name {
    font-size: 14px;
    font-weight: 500;
  }

  /* hero */
  .pricing-hero {
    padding: var(--space-3xl) var(--space-xl) var(--space-2xl);
    text-align: center;
    display: flex;
    justify-content: center;
  }
  .pricing-hero-content {
    max-width: 600px;
  }
  .pricing-sub {
    margin-top: var(--space-lg);
    margin-left: auto;
    margin-right: auto;
  }

  /* flow */
  .pricing-flow {
    max-width: 520px;
    margin: 0 auto;
    padding: 0 var(--space-xl) var(--space-3xl);
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .flow-step {
    width: 100%;
    text-align: center;
    padding: var(--space-xl);
  }

  .flow-step-free {
    border: 1px solid var(--border-strong);
    border-radius: var(--radius);
  }

  .flow-step-pro {
    position: relative;
    border-color: var(--accent);
    box-shadow: 0 0 30px var(--glow-accent);
  }

  .flow-badge {
    position: absolute;
    top: calc(-1 * var(--space-sm) - 2px);
    right: var(--space-lg);
    background: var(--accent);
    color: var(--bg);
    font-size: 11px;
    font-weight: 500;
    padding: 2px 10px;
    border-radius: var(--radius);
  }

  .flow-label {
    font-size: 12px;
    font-weight: 500;
    color: var(--text-secondary);
    letter-spacing: 0.04em;
    margin-bottom: var(--space-sm);
  }

  .flow-price {
    font-size: 48px;
    font-weight: 700;
    color: var(--accent);
    line-height: 1.1;
    margin-bottom: var(--space-sm);
  }

  .flow-headline {
    font-size: 18px;
    font-weight: 500;
    color: var(--text-primary);
    margin-bottom: var(--space-sm);
  }

  .flow-desc {
    font-size: 13px;
    color: var(--text-secondary);
    margin-bottom: var(--space-xl);
    line-height: 1.6;
  }

  .flow-cta {
    width: 100%;
    text-align: center;
    justify-content: center;
  }

  /* connector */
  .flow-connector {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-sm);
    padding: var(--space-lg) 0;
  }

  .flow-connector-line {
    width: 1px;
    height: 20px;
    border-left: 1px dashed var(--border-strong);
  }

  .flow-connector-label {
    font-size: 12px;
    font-weight: 500;
    color: var(--text-secondary);
    letter-spacing: 0.04em;
  }

  /* features */
  .pricing-features {
    max-width: 520px;
    margin: 0 auto;
    padding: 0 var(--space-xl) var(--space-3xl);
    text-align: center;
  }

  .features-heading {
    font-size: 14px;
    font-weight: 500;
    color: var(--text-secondary);
    margin-bottom: var(--space-xl);
  }

  .feature-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    text-align: left;
  }

  .feature-item {
    display: flex;
    align-items: baseline;
    gap: var(--space-sm);
    font-size: 14px;
    color: var(--text-secondary);
  }

  .feature-check {
    flex-shrink: 0;
    width: 20px;
    text-align: center;
    font-size: 13px;
    color: var(--saved);
  }

  /* reassurance */
  .pricing-reassurance {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: var(--space-md);
    padding: 0 var(--space-xl) var(--space-3xl);
    flex-wrap: wrap;
  }

  .reassurance-item {
    font-size: 13px;
    color: var(--text-secondary);
  }

  .reassurance-dot {
    font-size: 13px;
    color: var(--border-strong);
  }

  /* faq */
  .pricing-faq {
    padding: var(--space-3xl) var(--space-xl);
    max-width: 820px;
    margin: 0 auto;
  }
  .pricing-faq .heading-lg {
    margin-bottom: var(--space-xl);
  }
  .faq-grid {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }
  .faq-item {
    border-bottom: 1px solid var(--border);
    padding-bottom: var(--space-lg);
  }
  .faq-item:last-child {
    border-bottom: none;
  }
  .faq-q {
    font-size: 15px;
    font-weight: 500;
    color: var(--text-primary);
    margin-bottom: var(--space-sm);
  }
  .faq-a {
    font-size: 14px;
    color: var(--text-secondary);
    line-height: 1.7;
  }

  /* responsive */
  @media (max-width: 640px) {
    .pricing-hero {
      padding: var(--space-2xl) var(--space-lg) var(--space-xl);
    }
    .pricing-flow {
      padding: 0 var(--space-lg) var(--space-2xl);
    }
    .pricing-features {
      padding: 0 var(--space-lg) var(--space-2xl);
    }
    .pricing-reassurance {
      padding: 0 var(--space-lg) var(--space-2xl);
      flex-direction: column;
      gap: var(--space-sm);
    }
    .reassurance-dot {
      display: none;
    }
    .pricing-faq {
      padding: var(--space-2xl) var(--space-lg);
    }
    .flow-price {
      font-size: 40px;
    }
  }
</style>
