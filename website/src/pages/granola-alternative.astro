---
import Base from '../layouts/Base.astro';
import Footer from '../components/Footer.astro';

const features = [
  {
    label: 'Pricing',
    fiddlehead: 'Free / Open source',
    granola: '$18/mo',
    fiddleheadWin: true,
  },
  {
    label: 'Subscription required',
    fiddlehead: 'No',
    granola: 'Yes',
    fiddleheadWin: true,
  },
  {
    label: 'Meeting bot joins call',
    fiddlehead: 'No',
    granola: 'No',
  },
  {
    label: 'Speaker diarization',
    fiddlehead: 'Named speakers',
    granola: 'No',
    fiddleheadWin: true,
  },
  {
    label: 'Output format',
    fiddlehead: 'Markdown + YAML',
    granola: 'Proprietary',
    fiddleheadWin: true,
  },
  {
    label: 'Data storage',
    fiddlehead: 'Local (your Mac)',
    granola: 'Cloud',
    fiddleheadWin: true,
  },
  {
    label: 'AI-agent ready',
    fiddlehead: 'Yes (YAML frontmatter)',
    granola: 'MCP only',
    fiddleheadWin: true,
  },
  {
    label: 'Platform',
    fiddlehead: 'macOS',
    granola: 'macOS, Windows, Web',
  },
  {
    label: 'File ownership',
    fiddlehead: 'Plain .md files',
    granola: 'Cloud-locked',
    fiddleheadWin: true,
  },
  {
    label: 'Free tier',
    fiddlehead: 'Unlimited',
    granola: '25 meetings',
    fiddleheadWin: true,
  },
];

const differences = [
  {
    title: 'speaker diarization',
    desc: 'fiddlehead identifies every speaker by name. granola doesn\'t do speaker diarization at all — you get "Me" and "Them" at best.',
  },
  {
    title: 'local markdown files',
    desc: 'notes are saved as plain .md files on your mac. no cloud lock-in, no export button, no proprietary format.',
  },
  {
    title: 'free and open source, not $18/month',
    desc: 'mit licensed, unlimited recordings forever. granola costs $216/year and requires an active subscription to keep using.',
  },
  {
    title: 'ai-agent ready',
    desc: 'yaml frontmatter with date, speakers, topics, and tags. your ai agents can query meeting notes directly from the filesystem.',
  },
  {
    title: 'no account required',
    desc: 'download, add your api keys, and start recording. no sign-up, no account, no data on our servers.',
  },
];
---

<Base
  title="granola alternative — fiddlehead, private ai meeting notes for macos"
  description="looking for a granola alternative? fiddlehead is a private, local-first meeting note taker for macos. ai meeting transcription, speaker diarization, free and open source — no subscription."
>
  <nav class="page-nav">
    <div class="page-nav-inner">
      <a href="/" class="page-nav-logo" aria-label="Back to home">
        <img src="/images/frog-icon.svg" alt="" width="28" height="21" />
        <span class="page-nav-name">fiddlehead</span>
      </a>
    </div>
  </nav>

  <main>
    <section class="alt-hero">
      <div class="alt-hero-content hero-enter hero-enter-1">
        <h1 class="heading-lg">a local-first granola alternative</h1>
        <p class="subhead alt-sub">
          private ai meeting transcription with speaker diarization, markdown output, and no subscription.
        </p>
      </div>
    </section>

    <section class="alt-intro">
      <p class="alt-intro-text hero-enter hero-enter-2">
        fiddlehead is a granola alternative that keeps your meeting notes on your mac as plain markdown files. like granola, it captures meeting audio without a bot joining the call. unlike granola, fiddlehead identifies speakers by name, saves structured notes locally instead of in the cloud, and is free and open source (mit licensed) — no subscription, no vendor. it's a private meeting note taker built for people who want to own their data and use it with ai agents.
      </p>
    </section>

    <section class="alt-table-section">
      <h2 class="heading-md reveal">fiddlehead vs granola</h2>
      <div class="table-scroll reveal reveal-delay-1">
        <table class="alt-table">
          <thead>
            <tr>
              <th class="col-feature"></th>
              <th class="col-fiddlehead">fiddlehead</th>
              <th class="col-competitor">granola</th>
            </tr>
          </thead>
          <tbody>
            {features.map(f => (
              <tr>
                <td class="col-feature">{f.label}</td>
                <td class:list={['col-fiddlehead', { 'cell-win': f.fiddleheadWin }]}>{f.fiddlehead}</td>
                <td class="col-competitor">{f.granola}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="alt-diff">
      <h2 class="heading-md reveal">key differences</h2>
      <div class="diff-grid reveal reveal-delay-1">
        {differences.map(d => (
          <div class="diff-card">
            <span class="glyph glyph-saved">✓</span>
            <div>
              <strong class="diff-title">{d.title}</strong>
              <p class="diff-desc">{d.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <section class="alt-cta reveal">
      <a href="/download" class="btn-primary">download for macos</a>
      <p class="cta-note">free and open source — bring your own api key, no account required.</p>
      <p class="cta-link"><a href="/compare/">see full comparison with otter and fireflies →</a></p>
    </section>
  </main>

  <Footer />
</Base>

<style>
  /* nav */
  .page-nav {
    border-bottom: 1px solid var(--border);
    padding: 0 var(--space-xl);
  }
  .page-nav-inner {
    max-width: 1080px;
    margin: 0 auto;
    height: 52px;
    display: flex;
    align-items: center;
  }
  .page-nav-logo {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    color: var(--text-primary);
  }
  .page-nav-logo:hover {
    color: var(--accent);
  }
  .page-nav-name {
    font-size: 14px;
    font-weight: 500;
  }

  /* hero */
  .alt-hero {
    padding: var(--space-3xl) var(--space-xl) var(--space-2xl);
    text-align: center;
    display: flex;
    justify-content: center;
  }
  .alt-hero-content {
    max-width: 640px;
  }
  .alt-sub {
    margin-top: var(--space-lg);
    margin-left: auto;
    margin-right: auto;
  }

  /* intro */
  .alt-intro {
    max-width: 720px;
    margin: 0 auto;
    padding: 0 var(--space-xl) var(--space-2xl);
    text-align: center;
  }
  .alt-intro-text {
    font-size: 15px;
    color: var(--text-secondary);
    line-height: 1.7;
  }

  /* table */
  .alt-table-section {
    max-width: 720px;
    margin: 0 auto;
    padding: 0 var(--space-xl) var(--space-3xl);
  }
  .alt-table-section .heading-md {
    text-align: center;
    margin-bottom: var(--space-xl);
  }
  .table-scroll {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
  }
  .alt-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 14px;
  }
  .alt-table thead {
    border-bottom: 1px solid var(--border);
  }
  .alt-table th {
    padding: 12px 16px;
    font-size: 12px;
    font-weight: 500;
    text-align: left;
    letter-spacing: 0.04em;
  }
  .alt-table td {
    padding: 10px 16px;
    border-top: 1px solid var(--border);
    line-height: 1.5;
  }
  .col-feature {
    color: var(--text-primary);
    font-weight: 500;
    white-space: nowrap;
  }
  .col-fiddlehead {
    color: var(--accent);
    background: rgba(208, 165, 83, 0.04);
  }
  th.col-fiddlehead {
    color: var(--accent);
  }
  .col-competitor {
    color: var(--text-secondary);
    opacity: 0.7;
  }
  th.col-competitor {
    opacity: 0.5;
  }
  .cell-win {
    font-weight: 500;
  }

  /* differences */
  .alt-diff {
    max-width: 820px;
    margin: 0 auto;
    padding: 0 var(--space-xl) var(--space-3xl);
  }
  .alt-diff .heading-md {
    text-align: center;
    margin-bottom: var(--space-xl);
  }
  .diff-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-lg);
  }
  .diff-card {
    display: flex;
    gap: var(--space-md);
    padding: var(--space-xl);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface);
  }
  .diff-card .glyph {
    flex-shrink: 0;
    font-size: 14px;
    margin-top: 2px;
  }
  .diff-title {
    color: var(--text-primary);
    font-weight: 500;
    font-size: 15px;
    display: block;
    margin-bottom: 4px;
  }
  .diff-desc {
    color: var(--text-secondary);
    font-size: 13px;
    line-height: 1.65;
  }

  /* cta */
  .alt-cta {
    text-align: center;
    padding: 0 var(--space-xl) var(--space-3xl);
  }
  .cta-note {
    margin-top: var(--space-md);
    font-size: 13px;
    color: var(--text-secondary);
  }
  .cta-link {
    margin-top: var(--space-lg);
    font-size: 14px;
  }
  .cta-link a {
    color: var(--accent);
  }
  .cta-link a:hover {
    text-decoration: underline;
  }

  /* responsive */
  @media (max-width: 768px) {
    .diff-grid {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 640px) {
    .alt-hero {
      padding: var(--space-2xl) var(--space-lg) var(--space-xl);
    }
    .alt-intro {
      padding: 0 var(--space-lg) var(--space-xl);
    }
    .alt-table-section {
      padding: 0 var(--space-lg) var(--space-2xl);
    }
    .alt-diff {
      padding: 0 var(--space-lg) var(--space-2xl);
    }
    .alt-cta {
      padding: 0 var(--space-lg) var(--space-2xl);
    }
  }
</style>
